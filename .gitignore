# Dependencies
node_modules/
calc/node_modules/
import/node_modules/

# Build output
calc/dist/
# Allow publishing the Cracked Emerald JSON artifacts while keeping other dist output ignored.
import/dist/*
!import/dist/cracked-emerald-species.json
!import/dist/cracked-emerald-moves.json
calc/.tsbuildinfo
import/.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor/OS junk
.DS_Store
.idea/
.vscode/
